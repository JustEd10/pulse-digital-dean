# Optional environment variables. Export before running; no dotenv dependency.
HOST=127.0.0.1
PORT=8000
PULSE_DB=./data/pulse.sqlite3
# Set to 1 only behind HTTPS; reverse proxy must preserve Host.
COOKIE_SECURE=0
# Optional: exact peer IPs of your sole reverse proxy. It must overwrite X-Forwarded-For.
# Empty is safe for direct local access; forwarded headers are ignored.
TRUSTED_PROXY_IPS=
